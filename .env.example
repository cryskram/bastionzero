# Preferred: programmatic credentials from your Krutrim account/IAM settings.
# Uncomment only if your Krutrim account issued an account ID for programmatic auth.
# TF_VAR_krutrim_account_id="YOUR_KRUTRIM_ACCOUNT_ID"
TF_VAR_krutrim_access_key="YOUR_KRUTRIM_ACCESS_KEY"
TF_VAR_krutrim_secret_key="YOUR_KRUTRIM_SECRET_KEY"

# Fallback only: uncomment these if programmatic access is not enabled.
# TF_VAR_krutrim_email="YOUR_KRUTRIM_LOGIN_EMAIL"
# TF_VAR_krutrim_password="YOUR_KRUTRIM_PASSWORD"
# TF_VAR_krutrim_is_root_user="false"